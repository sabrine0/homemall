# Root origin of the API — NO trailing slash, NO /api suffix.
# Example: https://homemall.tomorrow.ma
# Leave empty when the web app and API share the same public hostname
# (Next.js rewrites will proxy /api/* automatically).
NEXT_PUBLIC_API_URL=""
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
# Optional Next.js server-side origin for SSR requests (bypasses the public proxy).
# Example: http://api:4000  (internal Docker service name)
API_SERVER_URL=""
COOKIE_NAME="homemall_token"
