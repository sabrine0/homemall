# Pass this value with:
# Flutter Web: flutter run -d chrome --dart-define=API_BASE_URL=http://localhost:4000
# Android emulator: flutter run --dart-define=API_BASE_URL=http://10.0.2.2:4000
API_BASE_URL=http://localhost:4000

# Google Maps API key:
# Android: put in apps/mobile/android/local.properties as GOOGLE_MAPS_API_KEY=...
# iOS: set in apps/mobile/ios/Flutter/Debug.xcconfig and Release.xcconfig
GOOGLE_MAPS_API_KEY=
