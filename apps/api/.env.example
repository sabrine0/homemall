DATABASE_URL="postgresql://postgres:postgres@localhost:5432/homemall?schema=public"
PORT=4000
JWT_SECRET="super-secret-change-me"
JWT_EXPIRES_IN="7d"
# Comma-separated list of allowed CORS origins.
# Example for production: https://homemall.tomorrow.ma
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"
COOKIE_NAME="homemall_token"
# Set to true only for local/demo environments that need sample Morocco zones.
SEED_DEMO_ZONES="true"
