# ── Required ──────────────────────────────────────────────────
# Public URL of the app (used for CORS and cookies)
APP_ORIGIN=https://homemall.yourdomain.com

# Secret for JWT signing — must be at least 16 characters
JWT_SECRET=change-this-to-a-long-random-value

# Database password — use a strong password in production
POSTGRES_PASSWORD=change-this-to-a-strong-password

# ── Super Admin (created during seed) ─────────────────────────
SUPER_ADMIN_EMAIL=admin@homemall.local
SUPER_ADMIN_PASSWORD=Admin12345!

# ── Optional: Manager Account (created during seed if both set)
# MANAGER_EMAIL=manager@homemall.local
# MANAGER_PASSWORD=Manager12345!

# ── Optional Overrides ────────────────────────────────────────
# JWT_EXPIRES_IN=7d
# COOKIE_NAME=homemall_token
# POSTGRES_USER=postgres
# POSTGRES_DB=homemall

# ── Google Maps (optional, enables map features on web) ───────
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── Marketplace Sync (optional) ──────────────────────────────
# EXTERNAL_INGESTION_ENABLED=false
# EXTERNAL_INGESTION_INTERVAL_MINUTES=360
# EXTERNAL_INGESTION_MAX_ROWS=120
# EXTERNAL_INGESTION_DEACTIVATE_MISSING=true
