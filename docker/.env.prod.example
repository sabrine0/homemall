# ─────────────────────────────────────────────────────────────
# Coolify Environment Variables
# All ${VAR} references in docker-compose.prod.yml are auto-detected
# by Coolify and shown as editable fields in the dashboard.
# Set values there — no .env file needed.
# ─────────────────────────────────────────────────────────────

# ── Auto-Generated by Coolify (magic variables) ──────────────
# SERVICE_PASSWORD_POSTGRES  → random secure DB password (auto-generated, shared across services)
# SERVICE_PASSWORD_JWT       → random secure JWT secret (auto-generated, min 16 chars)

# ── Required (set in Coolify dashboard) ───────────────────────
# APP_ORIGIN                 → public URL, e.g. https://homemall.yourdomain.com
# DATABASE_URL               → optional external Postgres URL; if omitted, compose uses the bundled postgres service

# ── Super Admin (created during seed) ─────────────────────────
# SUPER_ADMIN_EMAIL          → default: admin@homemall.local
# SUPER_ADMIN_PASSWORD       → default: Admin12345!

# ── Optional ──────────────────────────────────────────────────
# POSTGRES_USER              → default: postgres
# POSTGRES_DB                → default: homemall
# JWT_EXPIRES_IN             → default: 7d
# COOKIE_NAME                → default: homemall_token
# MANAGER_EMAIL              → optional manager account email
# MANAGER_PASSWORD           → optional manager account password
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY → enables map features on web
# EXTERNAL_INGESTION_ENABLED              → default: false
# EXTERNAL_INGESTION_INTERVAL_MINUTES     → default: 360
# EXTERNAL_INGESTION_MAX_ROWS             → default: 120
# EXTERNAL_INGESTION_DEACTIVATE_MISSING   → default: true
