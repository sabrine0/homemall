# Public app origin used for CORS and cookies.
# Example:
# APP_ORIGIN=https://homemall-demo.yourdomain.com
APP_ORIGIN=http://localhost

# Shared secret for JWT signing.
# MUST be changed before sharing outside local machine.
JWT_SECRET=change-this-to-a-long-random-value

# Optional overrides
JWT_EXPIRES_IN=7d
COOKIE_NAME=homemall_token
HTTP_PORT=80

# Database credentials used by docker-compose.share.yml
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=homemall
